OPENROUTER_API_KEY=
# Модель OpenRouter. Можно заменить любой с openrouter.ai/models
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
# Необязательно: один провайдер модели, без запасных (ID провайдера со страницы модели)
OPENROUTER_PROVIDER=modelrun/fp4
# Рекомендуется: токен бота от @BotFather — тогда API принимает запросы только из Telegram
TELEGRAM_BOT_TOKEN=
